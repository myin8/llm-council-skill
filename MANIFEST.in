# Include important documentation
include README.md
include LICENSE
include INSTALL.md
include QUICKSTART.md
include CLAUDE.md
include CHANGELOG.md
include COMPARISON.md
include SUMMARY.md

# Include environment template
include .env.example

# Include skill definition
recursive-include .claude/skills *.md

# Exclude development files
exclude test_structure.py
exclude PACKAGING.md

# Exclude Python bytecode and cache
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
